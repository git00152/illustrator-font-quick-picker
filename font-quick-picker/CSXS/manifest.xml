          <Menu>Font Quick Picker</Menu>
          <Geometry>
            <Size><Height>640</Height><Width>360</Width></Size>
            <MinSize><Height>300</Height><Width>260</Width></MinSize>
            <MaxSize><Height>9999</Height><Width>9999</Width></MaxSize>
